# MAGI System - Environment Configuration
# Copie este arquivo para .env e preencha com suas chaves de API

# ============================================
# LLM API Keys
# ============================================

# Anthropic Claude API Key  — MELCHIOR (científico, com busca web) + síntese final
# Obtenha em: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Google Gemini API Key — BALTHASAR (ético, com poder de veto)
# Obtenha em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key — GASPAR (prático) + o juiz que classifica as posições
# Gratuito, sem cartão: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# Model Configuration (Optional)
# ============================================

# Modelos por papel — os defaults ficam em config.py e foram verificados via API.
# IDs de modelo são aposentados com frequência: se der erro 404, liste os modelos
# disponíveis para a sua chave antes de chutar um ID.
# MELCHIOR_MODEL=claude-opus-5
# BALTHASAR_MODEL=gemini-3.5-flash
# GASPAR_MODEL=llama-3.3-70b-versatile
# JUDGE_MODEL=openai/gpt-oss-120b

# ============================================
# System Parameters (Optional)
# ============================================

# Temperature (0.0 - 1.0): Controla criatividade vs. consistência
# TEMPERATURE=0.7

# Max Tokens por resposta
# MAX_TOKENS=2048

# Limiar de consenso (0.0 - 1.0)
# CONSENSUS_THRESHOLD=0.66

# Timeout para requisições à API (segundos)
# API_TIMEOUT=30

# Timeout total do sistema (segundos)
# TOTAL_TIMEOUT=60
